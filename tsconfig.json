{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noImplicitAny": true,
    "strict": true,
    "strictNullChecks": true,
    "typeRoots": [
      "./frontend/node_modules/@types"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      "@plugins/*": [
        "./plugins/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "frontend/**/*",
    "plugins/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "plugins/node_modules",
    "dist",
    "frontend/dist",
    "src-tauri",
    "frontend/src-tauri"
  ]
}
