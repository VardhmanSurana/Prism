{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bash run-web.sh",
    "build": "pnpm run frontend:build",
    "frontend": "cd frontend && pnpm run dev",
    "frontend:build": "cd frontend && pnpm run build",
    "frontend:typecheck": "cd frontend && pnpm exec tsc --noEmit",
    "backend": "cd backend_rust && cargo run",
    "backend:rust": "cd backend_rust && cargo run",
    "backend:test": "cd backend_rust && cargo test",
    "cli": "cd cli && cargo run",
    "cli:build": "cd cli && cargo build --release",
    "test": "pnpm run frontend:typecheck && pnpm run backend:test",
    "desktop": "bash run-desktop.sh",
    "web": "bash run-web.sh",
    "app": "bash run-desktop.sh",
    "tauri": "cd frontend && pnpm exec tauri",
    "server": "cd prism-server && docker compose up -d --build",
    "server:up": "cd prism-server && docker compose up -d --build",
    "server:down": "cd prism-server && docker compose down",
    "server:status": "cd prism-server && docker compose ps",
    "server:logs": "cd prism-server && docker compose logs -f"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "dependencies": {
    "framer-motion": "^12.43.0"
  }
}
