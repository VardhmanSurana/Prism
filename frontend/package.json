{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "tauri": "bash -c 'if [ -f ~/.tauri/prism.key ] && [ -z \"$TAURI_SIGNING_PRIVATE_KEY\" ]; then export TAURI_SIGNING_PRIVATE_KEY=\"$(cat ~/.tauri/prism.key)\"; export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=\"${TAURI_SIGNING_PRIVATE_KEY_PASSWORD:-}\"; fi; pnpm exec tauri \"$@\"' --",
    "tauri:build": "pnpm run tauri build",
    "test": "vitest run --environment jsdom"
  },
