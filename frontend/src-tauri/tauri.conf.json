{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "prism",
  "version": "0.1.0",
  "identifier": "com.prism.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3005",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "[ -f ./build.sh ] && bash ./build.sh || bash ../build.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Prism",
        "fullscreen": false,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../backend_rust/target/release/prism-backend-rust"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/VardhmanSurana/Prism/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NTA3RUZBNkQxMUUyODMKUldTRDRoRnQrbjVRcDMzQ3hBYUUzM0NKOEJjQjlzUHFsMUc1MG4vT2xka0RaYnlRSm00MEViRjAK"
    }
  }
}
